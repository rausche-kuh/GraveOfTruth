<Project>

  <!--
    Shared build for every mod in this repo. Each mod is a directory holding <Name>/<Name>.csproj,
    src/, assets/ and package/; the csproj itself only names the mod. Add a mod by copying that
    shape - the scripts in scripts/ pick it up automatically.
  -->

  <!-- Paths to the game / mod manager profile. Written by scripts/setup.*, gitignored. -->
  <Import Project="$(MSBuildThisFileDirectory)Valheim.props" Condition="Exists('$(MSBuildThisFileDirectory)Valheim.props')" />

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- Only src/ is ours; decompiled/ must never be compiled. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- Game assemblies are not CLS-tidy; keep the build quiet about them. -->
    <NoWarn>$(NoWarn);CS0436;MSB3277</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- net472 reference assemblies, so no Visual Studio install is needed. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <!-- Makes private game members (TombStone.IsOwner, m_nview, ...) visible at compile time. -->
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.3" PrivateAssets="all" />
  </ItemGroup>

  <!-- Valheim + Unity + BepInEx assemblies, staged into the shared lib/ by scripts/setup.*. -->
  <ItemGroup>
    <Reference Include="$(MSBuildThisFileDirectory)lib\*.dll"
               Exclude="$(MSBuildThisFileDirectory)lib\assembly_valheim.dll;$(MSBuildThisFileDirectory)lib\assembly_utils.dll"
               Private="false" />
    <Reference Include="$(MSBuildThisFileDirectory)lib\assembly_valheim.dll;$(MSBuildThisFileDirectory)lib\assembly_utils.dll"
               Private="false" Publicize="true" />
  </ItemGroup>

  <!-- Relative includes resolve against the mod directory, not this file. -->
  <ItemGroup>
    <Compile Include="src\**\*.cs" />
    <!-- Everything in assets/ ships next to the DLL, keeping its subfolder layout. -->
    <None Include="assets\**\*" CopyToOutputDirectory="PreserveNewest" Link="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
